#include <windows.h>

1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/cmake/windows/tpad.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "GNA SERVICES INC\0"
   VALUE "FileDescription", "Tpad text editor\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "tpad\0"
   VALUE "LegalCopyright", "Copyright (C) 2012-2026 Andrew Smith\0"
   VALUE "OriginalFilename", "tpad.exe\0"
   VALUE "ProductName", "Tpad\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
