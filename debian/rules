#!/usr/bin/make -f

TPAD_DISTRIBUTION ?= $(shell dpkg-parsechangelog -S Distribution)
TPAD_GTK3_SERIES := trusty xenial bionic focal jammy
TPAD_GTK_CONFIGURE_ARG := $(if $(filter $(TPAD_DISTRIBUTION),$(TPAD_GTK3_SERIES)),--gtk3)

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		$(TPAD_GTK_CONFIGURE_ARG) \
		--docdir=/usr/share/doc/tpad \
		--localstatedir=/var \
		--sharedstatedir=/var/lib \
		--mandir=/usr/share/man
